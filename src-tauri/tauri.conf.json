{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenAnime",
  "version": "1.1.2",
  "identifier": "com.openanime.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bunx svelte-kit sync && bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": {
      "../static/superlogo.mp4": "superlogo.mp4"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0NDM0MjE0M0UzNUFFQUQKUldTdHJqVStGRUpEMVB3R1NZUFJHTlkyYkE0cGJLZFM1WDAwMEVnRDk4eXdEYlk0K05ZVy9Kbm0K",
      "endpoints": [
        "https://raw.githubusercontent.com/Dark-Hunter-TR/OpenAnime-Desktops/main/updater/latest-stable.json"
      ]
    }
  }
}
